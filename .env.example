# CloudPilot AI local configuration. Copy to .env only if you need overrides.
# The desktop app works with zero configuration.

# Backend bind address and port (loopback only by design).
CLOUDPILOT_HOST=127.0.0.1
CLOUDPILOT_PORT=8000

# Persistence. Defaults to <repository>/cloudpilot.db; the installed desktop app
# uses %APPDATA%\cloudpilot-ai\cloudpilot.db.
# CLOUDPILOT_DB=C:/absolute/path/cloudpilot.db

# Built SPA directory served by FastAPI. Defaults to <repository>/frontend/dist.
# CLOUDPILOT_FRONTEND_DIST=C:/path/to/cloudpilot/frontend/dist

# Treat imported data older than this many hours as stale in the UI.
CLOUDPILOT_FRESHNESS_HOURS=24

# No cloud credentials are used by this project. Do not add any.
