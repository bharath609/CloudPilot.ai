# CloudPilot AI configuration. Copy to .env and adjust. Never commit .env.

# development | test | production
CLOUDPILOT_ENVIRONMENT=development
CLOUDPILOT_LOG_LEVEL=INFO

# Persistence. Leave the SQLite URL unset to use <repository>/cloudpilot.db, which is
# independent of the working directory. If you set a relative SQLite path, SQLAlchemy
# resolves it against the process working directory, so prefer an absolute path.
# CLOUDPILOT_DATABASE_URL=sqlite:///C:/absolute/path/cloudpilot.db
# CLOUDPILOT_DATABASE_URL=sqlite:////absolute/path/cloudpilot.db
# PostgreSQL example (used by docker-compose):
# CLOUDPILOT_DATABASE_URL=postgresql+psycopg://cloudpilot:cloudpilot_dev@127.0.0.1:5432/cloudpilot

# Create tables on startup (convenient locally). Use `alembic upgrade head` in production.
CLOUDPILOT_AUTO_CREATE_TABLES=true

# Ingestion guard rails.
CLOUDPILOT_MAX_UPLOAD_BYTES=10485760
CLOUDPILOT_MAX_ROWS=200000
CLOUDPILOT_MAX_ISSUES_PER_IMPORT=1000
CLOUDPILOT_STRICT_IMPORTS=false

# Comma-separated; no spaces required.
CLOUDPILOT_ALLOWED_CURRENCIES=USD,EUR,GBP,INR,CAD,AUD

# Waste detection rules (percentages 0-100) and evidence minimums.
CLOUDPILOT_IDLE_CPU_P95_PCT=15
CLOUDPILOT_IDLE_MEMORY_P95_PCT=30
CLOUDPILOT_RIGHTSIZE_CPU_AVG_PCT=50
CLOUDPILOT_RIGHTSIZE_MEMORY_AVG_PCT=70
CLOUDPILOT_MIN_OBSERVATION_DAYS=14
CLOUDPILOT_MIN_SAMPLES=24
CLOUDPILOT_ANALYSIS_COST_DAYS=30
CLOUDPILOT_MIN_MONTHLY_SAVINGS=1.00

# Sourced price catalogue, relative to the repository root. The shipped demo
# catalogue is synthetic; replace it with a sourced file before claiming real prices.
CLOUDPILOT_PRICE_CATALOGUE_PATH=pricing/catalogue/demo_prices.csv

# Forecasting: deterministic daily baselines with a chronological holdout.
# Missing calendar days count as zero spend; no FX conversion is applied.
CLOUDPILOT_FORECAST_HORIZON_DAYS=30
CLOUDPILOT_FORECAST_HOLDOUT_DAYS=14
CLOUDPILOT_FORECAST_MOVING_AVERAGE_DAYS=7
CLOUDPILOT_FORECAST_SEASON_LENGTH_DAYS=7
CLOUDPILOT_FORECAST_MIN_HISTORY_DAYS=28
CLOUDPILOT_FORECAST_MAX_HISTORY_DAYS=365
CLOUDPILOT_FORECAST_WARNING_HISTORY_DAYS=56
CLOUDPILOT_FORECAST_INTERVAL_QUANTILE=0.90

# AI advisor (Milestone 5). Optional and disabled by default: with the flag off,
# no network request is made and the deterministic explanation is returned.
# Only free OpenAI-compatible endpoints are supported. Never commit a real key.
CLOUDPILOT_LLM_ENABLED=false
CLOUDPILOT_LLM_PROVIDER=groq
CLOUDPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
CLOUDPILOT_LLM_MODEL=llama-3.1-8b-instant
# CLOUDPILOT_LLM_API_KEY=
# Free alternatives (change base URL/model as documented by the provider):
#   Gemini OpenAI compatibility: https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:                  https://openrouter.ai/api/v1
#   Local Ollama:                http://127.0.0.1:11434/v1
CLOUDPILOT_LLM_TIMEOUT_SECONDS=30
CLOUDPILOT_LLM_MAX_RETRIES=2
CLOUDPILOT_LLM_TEMPERATURE=0
CLOUDPILOT_LLM_MAX_OUTPUT_TOKENS=1200
CLOUDPILOT_LLM_JSON_MODE=true
CLOUDPILOT_LLM_MAX_PACKAGE_FINDINGS=20
CLOUDPILOT_LLM_MAX_PRIORITY_FINDINGS=10
CLOUDPILOT_LLM_MAX_EVIDENCE_CHARS=48000
CLOUDPILOT_LLM_MAX_RESPONSE_BYTES=200000

# Browser origins allowed to call the API when the Vite dev server is used.
CLOUDPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Static dashboard. Leave empty to auto-serve <repository>/frontend/dist when it
# exists; point it at another build directory to override. The API still works
# when no build is present.
# CLOUDPILOT_FRONTEND_DIST_DIR=C:/path/to/cloudpilot/frontend/dist

# No cloud credentials are used by this project. Do not add any.
