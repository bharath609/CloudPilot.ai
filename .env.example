# CloudPilot AI configuration. Copy to .env and adjust. Never commit .env.

# development | test | production
CLOUDPILOT_ENVIRONMENT=development
CLOUDPILOT_LOG_LEVEL=INFO

# Persistence. Leave the SQLite URL unset to use <repository>/cloudpilot.db, which is
# independent of the working directory. If you set a relative SQLite path, SQLAlchemy
# resolves it against the process working directory, so prefer an absolute path.
# CLOUDPILOT_DATABASE_URL=sqlite:///C:/absolute/path/cloudpilot.db
# CLOUDPILOT_DATABASE_URL=sqlite:////absolute/path/cloudpilot.db
# PostgreSQL example (used by docker-compose):
# CLOUDPILOT_DATABASE_URL=postgresql+psycopg://cloudpilot:cloudpilot_dev@127.0.0.1:5432/cloudpilot

# Create tables on startup (convenient locally). Use `alembic upgrade head` in production.
CLOUDPILOT_AUTO_CREATE_TABLES=true

# Ingestion guard rails.
CLOUDPILOT_MAX_UPLOAD_BYTES=10485760
CLOUDPILOT_MAX_ROWS=200000
CLOUDPILOT_MAX_ISSUES_PER_IMPORT=1000
CLOUDPILOT_STRICT_IMPORTS=false

# Comma-separated; no spaces required.
CLOUDPILOT_ALLOWED_CURRENCIES=USD,EUR,GBP,INR,CAD,AUD

# Browser origins allowed to call the API (Milestone 6 frontend).
CLOUDPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# No cloud credentials are used by this project. Do not add any.
